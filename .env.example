# Copy to server/.env (or export) for local runs. Never commit real values.

# Postgres in production. Leave empty locally to use an in-memory PGlite
# database, or set pglite://./pgdata to keep data between runs.
DATABASE_URL=

# Stripe (use test mode keys: sk_test_... and the endpoint's whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Owner dashboard password, 10+ characters
ADMIN_PASSWORD=

NETWORK_NAME=Main Street Screens
NETWORK_TIMEZONE=America/New_York
PUBLIC_URL=
MAX_CAMPAIGNS_PER_SCREEN=8
SEED_EXAMPLE_SCREENS=false
